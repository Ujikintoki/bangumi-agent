PROJECT_NAME="Bangumi Agentic System"
VERSION="0.1.1"
ENVIRONMENT="development"

# ── 数据库 ──────────────────────────────────────────────────
# PostgreSQL + pgvector。Docker 一键启动：
#   docker run -d --name bangumi-pg \
#     -e POSTGRES_USER=myuser -e POSTGRES_PASSWORD=mypassword \
#     -e POSTGRES_DB=bangumidb -p 5432:5432 pgvector/pgvector:pg16
DATABASE_URL=postgresql://myuser:mypassword@localhost:5432/bangumidb

# ── Bangumi API ─────────────────────────────────────────────
# 在 https://bgm.tv/dev/app 创建应用获取
BANGUMI_APP_ID=
BANGUMI_APP_SECRET=
# Bearer Token，部分私有 API 需要（可选）
BANGUMI_ACCESS_TOKEN=

# ── LLM（三选一） ──────────────────────────────────────────

# 方式 1: DeepSeek（推荐）
LLM_API_KEY=sk-your-deepseek-key
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com/v1

# 方式 2: Azure OpenAI
# LLM_API_KEY=your-azure-key
# LLM_MODEL=gpt-4o-mini
# LLM_AZURE_ENDPOINT=https://your-resource.openai.azure.com
# LLM_AZURE_API_VERSION=2024-10-21

# 方式 3: 其他 OpenAI 兼容 API
# LLM_API_KEY=your-key
# LLM_MODEL=gpt-4o
# LLM_BASE_URL=https://api.openai.com/v1

LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# ── 智谱 Embedding（L2 记忆 + RAG 必需） ───────────────────
# 在 https://open.bigmodel.cn 注册获取
ZHIPU_API_KEY=your-zhipu-key

# ── 可选配置 ────────────────────────────────────────────────
# BGM_LOG_LEVEL=DEBUG      # 日志级别，默认 INFO
# CRITIC_MODE=rule          # Critic 模式: llm（默认）| rule
# MEMORY_ENABLED=false      # 关闭 L2 记忆系统
